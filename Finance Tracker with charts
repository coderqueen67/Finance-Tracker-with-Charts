<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Your Finances</title>
  <style>
    :root {
      --ink: #001736;
      --muted: #8394b7;
      --label: #4c6388;
      --surface: #ffffff;
      --page: #f5f8fc;
      --line: #e9eef6;
      --shadow: 0 2px 4px rgba(23, 43, 77, .04);
      --blue: #6264f4;
      --cyan: #14b5ce;
      --amber: #f59e0b;
      --pink: #ec4899;
      --green: #12b981;
      --violet: #8b5cf6;
      --red: #f62559;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background: var(--page);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      letter-spacing: 0;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .app {
      width: min(100%, 640px);
      min-height: 100vh;
      margin: 0 auto;
      padding: 32px 12px 48px;
      background: var(--page);
    }

    .topbar {
      display: grid;
      grid-template-columns: 1fr 44px;
      gap: 12px;
      align-items: center;
      margin-bottom: 34px;
    }

    .eyebrow {
      margin: 0 0 4px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.3;
    }

    h1,
    h2,
    h3,
    p {
      margin: 0;
    }

    h1 {
      font-size: 23px;
      line-height: 1.15;
      font-weight: 800;
    }

    .icon-button {
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border: 0;
      border-radius: 8px;
      color: var(--muted);
      background: transparent;
      cursor: pointer;
    }

    .stack {
      display: grid;
      gap: 18px;
    }

    .summary-card,
    .panel,
    .transaction {
      border: 1px solid var(--line);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .summary-card {
      display: grid;
      grid-template-columns: 1fr 56px;
      align-items: start;
      min-height: 154px;
      padding: 38px 26px 28px;
      border-radius: 24px;
    }

    .summary-card .label {
      margin-bottom: 30px;
      color: var(--label);
      font-size: 14px;
      font-weight: 650;
    }

    .amount {
      font-size: clamp(29px, 7vw, 32px);
      line-height: 1;
      font-weight: 800;
      letter-spacing: 0;
    }

    .badge {
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border-radius: 16px;
    }

    .badge.balance {
      color: #4f46ff;
      background: #eef1ff;
    }

    .badge.income,
    .trend.income {
      color: #059669;
      background: #e9fbf3;
    }

    .badge.expense,
    .trend.expense {
      color: var(--red);
      background: #fff0f3;
    }

    .panel {
      padding: 30px 26px 25px;
      border-radius: 24px;
    }

    h2 {
      font-size: 19px;
      line-height: 1.2;
      font-weight: 800;
    }

    .chart-wrap {
      display: grid;
      justify-items: center;
      padding: 48px 0 36px;
    }

    .donut {
      width: 196px;
      aspect-ratio: 1;
      border-radius: 50%;
      background:
        conic-gradient(
          from 91deg,
          var(--blue) 0deg 242.6deg,
          transparent 242.6deg 244.6deg,
          var(--cyan) 244.6deg 298.1deg,
          transparent 298.1deg 300.1deg,
          var(--amber) 300.1deg 320.2deg,
          transparent 320.2deg 322.2deg,
          var(--pink) 322.2deg 336.4deg,
          transparent 336.4deg 338.4deg,
          var(--green) 338.4deg 348.4deg,
          transparent 348.4deg 350.4deg,
          var(--violet) 350.4deg 357.9deg,
          transparent 357.9deg 360deg
        );
      mask: radial-gradient(circle, transparent 0 33%, #000 34% 100%);
    }

    .legend {
      display: grid;
      gap: 13px;
    }

    .legend-row {
      display: grid;
      grid-template-columns: 14px 1fr auto;
      gap: 12px;
      align-items: center;
      color: #243957;
      font-size: 14px;
    }

    .dot {
      width: 12px;
      height: 12px;
      border-radius: 999px;
    }

    .legend-value {
      color: var(--ink);
      font-weight: 800;
    }

    .section-head {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      margin: 30px 0 16px;
    }

    .add-button {
      display: inline-grid;
      grid-template-columns: 18px auto;
      gap: 8px;
      align-items: center;
      min-height: 40px;
      padding: 0 16px;
      border: 0;
      border-radius: 13px;
      color: #fff;
      background: #151515;
      box-shadow: 0 2px 5px rgba(0, 0, 0, .16);
      font-weight: 750;
      cursor: pointer;
    }

    .transactions {
      display: grid;
      gap: 12px;
    }

    .transaction {
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      min-height: 80px;
      padding: 14px 22px 14px 18px;
      border-radius: 16px;
    }

    .trend {
      display: grid;
      width: 46px;
      height: 46px;
      place-items: center;
      border-radius: 15px;
    }

    .transaction-title {
      margin-bottom: 3px;
      overflow: hidden;
      font-size: 16px;
      font-weight: 800;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .transaction-note,
    .date {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.2;
    }

    .transaction-money {
      text-align: right;
      font-size: 16px;
      font-weight: 850;
    }

    .transaction-money.positive {
      color: #00a875;
    }

    .date {
      display: block;
      margin-top: 5px;
      font-size: 12px;
    }

    dialog {
      width: min(calc(100% - 32px), 420px);
      border: 0;
      border-radius: 18px;
      padding: 0;
      box-shadow: 0 24px 70px rgba(0, 23, 54, .22);
    }

    dialog::backdrop {
      background: rgba(0, 23, 54, .35);
    }

    .modal {
      display: grid;
      gap: 16px;
      padding: 24px;
      background: #fff;
    }

    .modal-head {
      display: grid;
      grid-template-columns: 1fr 34px;
      align-items: center;
      gap: 12px;
    }

    .form-grid {
      display: grid;
      gap: 12px;
    }

    .field {
      display: grid;
      gap: 7px;
      color: var(--label);
      font-size: 13px;
      font-weight: 750;
    }

    .field input,
    .field select {
      width: 100%;
      min-height: 44px;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 0 12px;
      color: var(--ink);
      background: #fff;
    }

    .modal-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 4px;
    }

    .secondary,
    .primary {
      min-height: 44px;
      border-radius: 10px;
      font-weight: 800;
      cursor: pointer;
    }

    .secondary {
      border: 1px solid var(--line);
      color: var(--ink);
      background: #fff;
    }

    .primary {
      border: 0;
      color: #fff;
      background: #151515;
    }

    @media (max-width: 420px) {
      .app {
        padding-inline: 10px;
      }

      .summary-card,
      .panel {
        padding-inline: 22px;
      }

      .chart-wrap {
        padding-top: 38px;
      }

      .donut {
        width: 176px;
      }

      .transaction {
        grid-template-columns: 50px minmax(0, 1fr) auto;
        padding-inline: 16px;
      }
    }
  </style>
</head>
<body>
  <main class="app">
    <header class="topbar">
      <div>
        <p class="eyebrow">Welcome back, Kerry</p>
        <h1>Your Finances</h1>
      </div>
      <button class="icon-button" type="button" aria-label="Sign out">
        <svg aria-hidden="true" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <path d="M16 17l5-5-5-5" />
          <path d="M21 12H9" />
        </svg>
      </button>
    </header>

    <section class="stack" aria-label="Financial summary">
      <article class="summary-card">
        <div>
          <p class="label">Balance</p>
          <p class="amount">$2,720.00</p>
        </div>
        <div class="badge balance" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 12V8.5A2.5 2.5 0 0 0 17.5 6H5a2 2 0 0 0 0 4h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8" />
            <path d="M17 14h.01" />
          </svg>
        </div>
      </article>

      <article class="summary-card">
        <div>
          <p class="label">Income</p>
          <p class="amount">$4,800.00</p>
        </div>
        <div class="badge income" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 17l6-6 4 4 8-8" />
            <path d="M17 7h4v4" />
          </svg>
        </div>
      </article>

      <article class="summary-card">
        <div>
          <p class="label">Expenses</p>
          <p class="amount">$2,080.00</p>
        </div>
        <div class="badge expense" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7l6 6 4-4 8 8" />
            <path d="M17 17h4v-4" />
          </svg>
        </div>
      </article>
    </section>

    <section class="panel" aria-labelledby="spending-title" style="margin-top: 18px;">
      <h2 id="spending-title">Spending by category</h2>
      <div class="chart-wrap" aria-hidden="true">
        <div class="donut"></div>
        <canvas id="balanceChart" width="360" height="260" style="max-width: 100%; margin-top: 24px;"></canvas>
      </div>
      <div class="legend">
        <div class="legend-row"><span class="dot" style="background: var(--blue);"></span><span>Housing</span><span class="legend-value">$1,450.00</span></div>
        <div class="legend-row"><span class="dot" style="background: var(--cyan);"></span><span>Groceries</span><span class="legend-value">$320.00</span></div>
        <div class="legend-row"><span class="dot" style="background: var(--amber);"></span><span>Entertainment</span><span class="legend-value">$120.00</span></div>
        <div class="legend-row"><span class="dot" style="background: var(--pink);"></span><span>Food &amp; Dining</span><span class="legend-value">$85.00</span></div>
        <div class="legend-row"><span class="dot" style="background: var(--green);"></span><span>Transport</span><span class="legend-value">$60.00</span></div>
        <div class="legend-row"><span class="dot" style="background: var(--violet);"></span><span>Utilities</span><span class="legend-value">$45.00</span></div>
      </div>
    </section>

    <section aria-labelledby="transactions-title">
      <div class="section-head">
        <h2 id="transactions-title">Transactions</h2>
        <button class="add-button" type="button" id="openModal">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14" />
            <path d="M5 12h14" />
          </svg>
          <span>Add</span>
        </button>
      </div>

      <div class="transactions" id="transactions">
        <article class="transaction">
          <span class="trend expense" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span>
          <div><h3 class="transaction-title">Utilities</h3><p class="transaction-note">Internet</p></div>
          <p class="transaction-money">-$45.00<span class="date">Jun 13</span></p>
        </article>
        <article class="transaction">
          <span class="trend expense" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span>
          <div><h3 class="transaction-title">Entertainment</h3><p class="transaction-note">Concert tickets</p></div>
          <p class="transaction-money">-$120.00<span class="date">Jun 11</span></p>
        </article>
        <article class="transaction">
          <span class="trend income" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 17H7V7" /><path d="M17 7 7 17" /></svg></span>
          <div><h3 class="transaction-title">Freelance</h3><p class="transaction-note">Side project</p></div>
          <p class="transaction-money positive">+$600.00<span class="date">Jun 9</span></p>
        </article>
        <article class="transaction">
          <span class="trend expense" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span>
          <div><h3 class="transaction-title">Transport</h3><p class="transaction-note">Gas</p></div>
          <p class="transaction-money">-$60.00<span class="date">Jun 7</span></p>
        </article>
        <article class="transaction">
          <span class="trend expense" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span>
          <div><h3 class="transaction-title">Food &amp; Dining</h3><p class="transaction-note">Dinner out</p></div>
          <p class="transaction-money">-$85.00<span class="date">Jun 6</span></p>
        </article>
        <article class="transaction">
          <span class="trend expense" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span>
          <div><h3 class="transaction-title">Groceries</h3><p class="transaction-note">Weekly shop</p></div>
          <p class="transaction-money">-$320.00<span class="date">Jun 4</span></p>
        </article>
        <article class="transaction">
          <span class="trend expense" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg></span>
          <div><h3 class="transaction-title">Housing</h3><p class="transaction-note">Rent</p></div>
          <p class="transaction-money">-$1,450.00<span class="date">Jun 1</span></p>
        </article>
        <article class="transaction">
          <span class="trend income" aria-hidden="true"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 17H7V7" /><path d="M17 7 7 17" /></svg></span>
          <div><h3 class="transaction-title">Salary</h3><p class="transaction-note">Monthly salary</p></div>
          <p class="transaction-money positive">+$4,200.00<span class="date">May 31</span></p>
        </article>
      </div>
    </section>
  </main>

  <dialog id="transactionDialog">
    <form class="modal" method="dialog" id="transactionForm">
      <div class="modal-head">
        <h2>New transaction</h2>
        <button class="icon-button" type="button" id="closeModal" aria-label="Close">
          <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
      <div class="form-grid">
        <label class="field">Name <input name="name" value="Coffee" required /></label>
        <label class="field">Note <input name="note" value="Morning stop" required /></label>
        <label class="field">Amount <input name="amount" type="number" step="0.01" value="6.50" required /></label>
        <label class="field">Type
          <select name="type">
            <option value="expense">Expense</option>
            <option value="income">Income</option>
          </select>
        </label>
      </div>
      <div class="modal-actions">
        <button class="secondary" type="button" id="cancelModal">Cancel</button>
        <button class="primary" type="submit">Add transaction</button>
      </div>
    </form>
  </dialog>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    const dialog = document.querySelector("#transactionDialog");
    const openModal = document.querySelector("#openModal");
    const closeModal = document.querySelector("#closeModal");
    const cancelModal = document.querySelector("#cancelModal");
    const form = document.querySelector("#transactionForm");
    const list = document.querySelector("#transactions");

    const money = new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD"
    });

    openModal.addEventListener("click", () => dialog.showModal());
    closeModal.addEventListener("click", () => dialog.close());
    cancelModal.addEventListener("click", () => dialog.close());

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const type = data.get("type");
      const rawAmount = Math.abs(Number(data.get("amount")));
      const signed = type === "income" ? rawAmount : -rawAmount;
      const article = document.createElement("article");
      article.className = "transaction";
      article.innerHTML = `
        <span class="trend ${type}" aria-hidden="true">
          ${type === "income"
            ? '<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 17H7V7" /><path d="M17 7 7 17" /></svg>'
            : '<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg>'}
        </span>
        <div>
          <h3 class="transaction-title"></h3>
          <p class="transaction-note"></p>
        </div>
        <p class="transaction-money ${type === "income" ? "positive" : ""}">
          ${signed > 0 ? "+" : "-"}${money.format(Math.abs(signed))}
          <span class="date">Today</span>
        </p>
      `;
      article.querySelector(".transaction-title").textContent = data.get("name");
      article.querySelector(".transaction-note").textContent = data.get("note");
      list.prepend(article);
      dialog.close();
      form.reset();
      refreshChart();
    });

    const balanceChartEl = document.querySelector("#balanceChart");
    let balanceChart;

    function parseAmount(text) {
      const sign = text.includes("+") ? 1 : text.includes("-") ? -1 : 1;
      const numeric = Number(text.replace(/[^0-9.]/g, ""));
      return sign * (Number.isNaN(numeric) ? 0 : numeric);
    }

    function getTransactions() {
      return Array.from(document.querySelectorAll(".transaction"))
        .map((article) => {
          const amountText = article.querySelector(".transaction-money").textContent;
          const dateText = article.querySelector(".date").textContent;
          return {
            amount: parseAmount(amountText),
            date: dateText,
          };
        })
        .reverse();
    }

    function refreshChart() {
      const transactions = getTransactions();
      const labels = transactions.map((transaction) => transaction.date);
      let running = 0;
      const balances = transactions.map((transaction) => {
        running += transaction.amount;
        return Number(running.toFixed(2));
      });

      const data = {
        labels,
        datasets: [
          {
            label: "Running Balance",
            data: balances,
            borderColor: "#151515",
            backgroundColor: "rgba(21, 21, 21, 0.12)",
            tension: 0.3,
            fill: true,
            pointRadius: 4,
          },
        ],
      };

      const config = {
        type: "line",
        data,
        options: {
          responsive: true,
          plugins: {
            legend: { display: false },
            tooltip: { mode: "index", intersect: false },
          },
          scales: {
            x: {
              title: { display: true, text: "Date" },
            },
            y: {
              title: { display: true, text: "Balance" },
            },
          },
        },
      };

      if (!balanceChart) {
        balanceChart = new Chart(balanceChartEl, config);
      } else {
        balanceChart.data = data;
        balanceChart.options = config.options;
        balanceChart.update();
      }
    }

    refreshChart();
  </script>
</body>
</html>
